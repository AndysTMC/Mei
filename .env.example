# Copy this file to .env. Never commit real credentials.
# Model-list checks are read-only. Chat checks run only with MEI_LIVE_CHAT=1.
MEI_LIVE_CHAT=0
MEI_LIVE_TIMEOUT_MS=15000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3:free

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-5

OPENCODE_API_KEY=
OPENCODE_GO_MODEL=mimo-v2.5
OPENCODE_ZEN_MODEL=big-pickle

# Local model IDs must match the names returned by your running server.
# Local providers are skipped unless explicitly enabled/configured.
OLLAMA_LIVE=0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud

# LLAMACPP_LIVE=1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=gemma-3-1b-it

# LMSTUDIO_LIVE=1
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=gemma-3-1b-it

# CUSTOM_BASE_URL=https://your-server.example/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=small-chat-model
